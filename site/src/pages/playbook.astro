---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const { Content } = await render((await getEntry('docs', 'playbook'))!);
---

<Base title="Playbook" description="The rules in force for this Skyrim SE list, on one page.">
  <h1 class="mb-8 text-4xl font-bold tracking-[-0.03em] text-strong">Playbook</h1>
  <article class="doc"><Content /></article>
</Base>
