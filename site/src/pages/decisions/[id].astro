---
import { getCollection, render } from 'astro:content';
import { ArrowLeft, ArrowRight } from 'lucide-react';
import StatusBadge from '../../components/StatusBadge.astro';
import Base from '../../layouts/Base.astro';
import { byNumber, getChecks, getSections, toDecision } from '../../lib/data';

export async function getStaticPaths() {
  const entries = await getCollection('decisions');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const decision = toDecision(entry);
const all = (await getCollection('decisions')).map(toDecision).sort(byNumber);
const index = all.findIndex((d) => d.id === decision.id);
const [previous, next] = [all[index - 1], all[index + 1]];
const sections = getSections().filter((s) => s.decisions.includes(decision.number));
const checks = getChecks().filter((c) => c.decision === decision.number);
const tones = { ok: 'text-accent-text', warn: 'text-amber', fail: 'text-danger' };
---

<Base title={`${decision.number}. ${decision.title}`} description={decision.summary}>
  <a href={`${base}/decisions/`} class="inline-flex items-center gap-1.5 text-sm text-secondary hover:text-strong"><ArrowLeft size={14} /> All decisions</a>
  <header class="mt-6 max-w-3xl">
    <div class="flex flex-wrap items-center gap-3">
      <span class="font-mono text-sm text-inactive">{decision.number}</span>
      <StatusBadge decision={decision} />
      <span class="text-xs text-inactive">{decision.date}</span>
    </div>
    <h1 class="mt-3 text-3xl leading-tight font-bold tracking-[-0.025em] text-balance text-strong sm:text-4xl" transition:name={`decision-${decision.number}`}>{decision.title}</h1>
    <p class="mt-4 text-lg leading-relaxed text-pretty text-secondary">{decision.summary}</p>
  </header>

  <div class="mt-10 grid items-start gap-10 lg:grid-cols-[1fr_16rem]">
    <article class="doc min-w-0"><Content /></article>
    {
      (sections.length > 0 || checks.length > 0) && (
        <aside class="grid gap-6 rounded-lg border border-line-subtle bg-bg-1 p-4 text-sm lg:sticky lg:top-20">
          {sections.length > 0 && (
            <div>
              <h2 class="mb-2 text-xs font-semibold text-secondary">Applies to</h2>
              <ul class="grid gap-1">
                {sections.map((section) => (
                  <li>
                    <a class="flex justify-between gap-3 hover:text-accent-text" href={`${base}/modlist/#${section.slug}`}>
                      {section.name} <span class="font-mono text-xs text-inactive">{section.mods.length}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {checks.length > 0 && (
            <div>
              <h2 class="mb-2 text-xs font-semibold text-secondary">Checked by</h2>
              <ul class="grid gap-1.5">
                {checks.map((check) => (
                  <li>
                    <span class={`font-mono text-xs uppercase ${tones[check.result]}`}>{check.result}</span> {check.title}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      )
    }
  </div>

  <nav aria-label="Other decisions" class="mt-14 grid gap-3 border-t border-line-subtle pt-6 sm:grid-cols-2">
    {
      previous ? (
        <a class="rounded-lg p-3 transition-colors hover:bg-bg-2" href={`${base}/decisions/${previous.id}/`}>
          <span class="flex items-center gap-1.5 text-xs text-inactive"><ArrowLeft size={13} /> {previous.number}</span>
          <span class="mt-1 block text-sm text-pretty text-strong">{previous.title}</span>
        </a>
      ) : <span />
    }
    {
      next && (
        <a class="rounded-lg p-3 transition-colors hover:bg-bg-2 sm:text-right" href={`${base}/decisions/${next.id}/`}>
          <span class="flex items-center gap-1.5 text-xs text-inactive sm:justify-end">{next.number} <ArrowRight size={13} /></span>
          <span class="mt-1 block text-sm text-pretty text-strong">{next.title}</span>
        </a>
      )
    }
  </nav>
</Base>
